@@ -149,9 +149,11 @@ class common_chat_peg_builder : public common_peg_parser_builder {
 
     // Helper for Python-style function call format: name(arg1="value1", arg2=123)
     // Used by LFM2 and similar templates
+    // allow_undeclared: also accept calls to names not in tools (any identifier, any arguments)
     common_peg_parser python_style_tool_calls(const common_json & tools,
                                               bool                           parallel_tool_calls,
-                                              bool                           allow_json_literals);
+                                              bool                           allow_json_literals,
+                                              bool                           allow_undeclared = false);
 
   private:
     // Python values plus JSON true/false/null.
diff --git a/common/parsers/lfm2.cpp b/common/parsers/lfm2.cpp
--- a/common/parsers/lfm2.cpp
+++ b/common/parsers/lfm2.cpp
@@ -83,7 +83,11 @@ common_chat_params common_chat_params_init_lfm2(const common_chat_template &
         auto tool_calls = p.rule("tool-calls",
             p.trigger_rule("tool-call",
                 p.literal(TOOL_CALL_START) +
-                p.python_style_tool_calls(inputs.tools, inputs.parallel_tool_calls, /* allow_json_literals = */ true) +
+                // xllama: undeclared calls only in auto mode. REQUIRED (and xllama's
