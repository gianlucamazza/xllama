+// Exact GELU vector-Jacobian product. Used only in the backward graph (no second derivatives).
+static void ggml_gelu_erf_vjp(struct ggml_tensor * dst, const struct ggml_tensor * x,
+        const struct ggml_tensor * dy, int ith, int nth, void * userdata) {
+    GGML_UNUSED(userdata);
+    GGML_ASSERT(x->type == GGML_TYPE_F32 && dy->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(x) && ggml_is_contiguous(dy));
+    const float * a = (const float *) x->data;
+    const float * g = (const float *) dy->data;
+    float * out = (float *) dst->data;
+    for (int64_t i = ith; i < ggml_nelements(x); i += nth) {
+        const float z = a[i];
+        out[i] = g[i] * (0.5f * (1.0f + erff(z * 0.7071067811865475f)) +
+                        z * expf(-0.5f * z * z) * 0.3989422804014327f);
+    }
+}
