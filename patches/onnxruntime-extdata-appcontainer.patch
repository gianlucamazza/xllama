+// The Xbox AppContainer cannot traverse every ancestor of its private data folder.
+static std::filesystem::path XllamaSafeCanonical(const std::filesystem::path& p) {
+  std::error_code ec;
+  auto canonical = std::filesystem::weakly_canonical(p, ec);
+  return ec || canonical.empty() ? p.lexically_normal() : canonical;
+}
