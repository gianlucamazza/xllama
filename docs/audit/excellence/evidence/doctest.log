      --gpugemv        Phase 15 H6.2 (#228) Q4_K GEMV density probe
                       (host: tiny-tile wave32 TDD; Linux reports d3d12
                       unavailable — no fake GB/s. Console A/B is gpugemv.flag)
      --ramceil        Probe how much heap this process can commit and
                       exit (no model needed); prints the CSV rows
      --greedy         Deterministic argmax decode (implies logit parity);
                       overrides --temp/--seed for reproducible output
      --dump-logits <path>
                       Write the last prefill-token logits (float32) to
                       <path> and metadata to <path>.json, then continue
      --validate-train-job <job.json>
                       Parse/validate a training job manifest and exit
                       (training pillar; no model load)
      --train-job <job.json>
                       Run lora_peft via the host runner, or partial_ft
                       in-process when the Lane B engine is compiled
      --training-capabilities
                       Print the training-pillar capability matrix
                       (available/experimental/designed/research/rejected)
      --embed          Run embedding smoke test: load model, embed one or
                       more inputs, print width/L2-norm/tokens/peak-RSS.
                       Requires -m <model.gguf>. Pass inputs via -p <text>
                       (repeatable). Optional: --dimensions <N> (0=native)
      --dimensions <N> Requested embedding dimensions for --embed (0=native)
      --lora <path>    GGUF LoRA adapter (llama.cpp only; runtime load)
      --lora-scale <f> LoRA scale (default: 1.0)
