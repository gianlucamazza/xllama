{
  "_comment": [
    "Full product showcase: local chat, feedback, on-device personalization,",
    "coding, and in-app diffusion. This is intentionally separate from the",
    "short technical demo and requires a real training base model on the console.",
    "The capture may be edited only at the named markers; prompts and results",
    "must remain visible in the published walkthrough."
  ],
  "total_timeout_s": 7200,
  "actions": [
    { "op": "set_model", "name": "smollm2-360m-cpu-int4" },
    {
      "op": "set_sampling",
      "temperature": 0.7,
      "top_p": 0.9,
      "n_predict": 220
    },
    { "op": "new_chat" },
    {
      "op": "send",
      "text": "In two sentences, explain why someone would run a language model locally.",
      "timeout_s": 300
    },
    { "op": "mark", "label": "chat-ready", "timeout_s": 120 },
    { "op": "rate", "name": "like" },
    { "op": "mark", "label": "feedback-saved", "timeout_s": 120 },
    {
      "op": "show_pane",
      "name": "settings",
      "label": "personalize-ready",
      "timeout_s": 120
    },
    { "op": "mark", "label": "training-started", "timeout_s": 120 },
    { "op": "start_train", "timeout_s": 1800 },
    { "op": "mark", "label": "training-done", "timeout_s": 120 },
    {
      "op": "show_pane",
      "name": "settings",
      "label": "personalized-ready",
      "timeout_s": 120
    },
    { "op": "set_model", "name": "personalized" },
    { "op": "new_chat" },
    {
      "op": "send",
      "text": "Give one concise practical tip for keeping private data off cloud services.",
      "timeout_s": 300
    },
    { "op": "mark", "label": "personalized-response", "timeout_s": 120 },
    { "op": "set_model", "name": "qwen25-coder-1.5b" },
    { "op": "new_chat" },
    {
      "op": "send",
      "text": "Write a C function that reverses a singly linked list in place. Just the function, no main and no explanation.",
      "timeout_s": 600
    },
    { "op": "mark", "label": "coding-done", "timeout_s": 120 },
    { "op": "set_model", "name": "smollm2-360m-cpu-int4" },
    {
      "op": "generate_image",
      "prompt": "pixel art robot holding a small local AI chip, simple colors",
      "steps": 1,
      "seed": 42,
      "timeout_s": 600
    },
    {
      "op": "show_pane",
      "name": "image",
      "label": "diffusion-done",
      "timeout_s": 120
    },
    { "op": "mark", "label": "showcase-final", "timeout_s": 120 }
  ]
}
