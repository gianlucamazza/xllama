<Page
    x:Class="xllama.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

  <!-- 48px safe area for Xbox TV overscan -->
  <Grid Margin="48">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header: model name + status + progress -->
    <StackPanel Grid.Row="0" Spacing="4">
      <TextBlock x:Name="ModelText"
                 Style="{StaticResource TitleTextBlockStyle}"
                 Text="xllama"/>
      <TextBlock x:Name="StatusText"
                 Style="{StaticResource BodyTextBlockStyle}"
                 Opacity="0.7"
                 Text="Ready"/>
      <controls:ProgressBar x:Name="LoadingBar"
                            IsIndeterminate="True"
                            Visibility="Collapsed"
                            Margin="0,8,0,0"/>
    </StackPanel>

    <!-- Body: prompt input + streaming output -->
    <ScrollViewer Grid.Row="1"
                  x:Name="OutputScroll"
                  VerticalScrollBarVisibility="Auto"
                  Margin="0,24,0,0">
      <StackPanel Spacing="16">
        <TextBox x:Name="PromptInput"
                 PlaceholderText="Type your prompt here (gamepad A → opens keyboard)..."
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="120"
                 IsSpellCheckEnabled="False"
                 FontSize="18"/>
        <TextBlock x:Name="OutputText"
                   TextWrapping="Wrap"
                   FontFamily="Consolas"
                   FontSize="20"
                   IsTextSelectionEnabled="True"/>
      </StackPanel>
    </ScrollViewer>

    <!-- Footer: metrics + action buttons -->
    <Grid Grid.Row="2" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <TextBlock x:Name="MetricsText"
                 Grid.Column="0"
                 Style="{StaticResource CaptionTextBlockStyle}"
                 VerticalAlignment="Center"
                 Opacity="0.7"/>

      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="12">
        <Button x:Name="RunButton"
                Content="▶  Run"
                Click="OnRunClick"
                MinWidth="120"/>
        <Button x:Name="CancelButton"
                Content="■  Cancel"
                Click="OnCancelClick"
                IsEnabled="False"
                MinWidth="120"/>
      </StackPanel>
    </Grid>
  </Grid>
</Page>
