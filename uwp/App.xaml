<Application
    x:Class="xllama.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- x:Class is required here so MarkupCompilePass1 generates App.g.h (AppT<App>).
         App::InitializeComponent is a runtime no-op on Xbox, so build-uwp.ps1 removes
         loose App.xaml from the final MSIX package layout. -->
</Application>
