<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="17.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- =====================================================================
       Configurations: Debug|x64 and Release|x64 only.
       Xbox Series S is x64 (Zen 2). No ARM64, no Win32.
       ===================================================================== -->
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <!-- =====================================================================
       Global properties — UWP app targeting Xbox Series S
       ===================================================================== -->
  <PropertyGroup Label="Globals">
    <ProjectGuid>{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}</ProjectGuid>
    <RootNamespace>xllama</RootNamespace>
    <DefaultLanguage>en-US</DefaultLanguage>
    <MinimumVisualStudioVersion>17.0</MinimumVisualStudioVersion>
    <AppContainerApplication>true</AppContainerApplication>
    <AppxPackage>true</AppxPackage>
    <ApplicationType>Windows Store</ApplicationType>
    <ApplicationTypeRevision>10.0</ApplicationTypeRevision>
    <!-- Pin to 22621 (22H2): the 26100 XAML compiler has a NullReferenceException
         (WMC9999) at MarkupCompilePass2 for C++/WinRT projects (no C++/CX metadata).
         SDK 22621 is installed on the windows-2022 CI runner. -->
    <WindowsTargetPlatformVersion>10.0.22621.0</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>10.0.19041.0</WindowsTargetPlatformMinVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <!-- =====================================================================
       Per-configuration base properties
       ===================================================================== -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <WholeProgramOptimization>false</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <!-- NuGet props — imported AFTER Microsoft.Cpp.props so $(IntDir) and
       $(GeneratedFilesDir) are already resolved when CppWinRT.props runs. -->
  <Import Project="packages\Microsoft.Windows.CppWinRT.2.0.240405.15\build\native\Microsoft.Windows.CppWinRT.props"
          Condition="Exists('packages\Microsoft.Windows.CppWinRT.2.0.240405.15\build\native\Microsoft.Windows.CppWinRT.props')" />

  <!-- =====================================================================
       Package / signing
       ===================================================================== -->
  <PropertyGroup>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
  </PropertyGroup>

  <!-- C++/WinRT XAML integration (via Microsoft.Windows.CppWinRT NuGet).
       Only Windows SDK XAML controls are used (Windows.UI.Xaml.Controls.*);
       WinUI 2 (Microsoft.UI.Xaml) was removed because CppWinRT 2.0 fails to
       generate projection headers from the WinUI 2.7 WinMD silently. -->
  <PropertyGroup>
    <CppWinRTGenerateWindowsMetadata>true</CppWinRTGenerateWindowsMetadata>
  </PropertyGroup>

  <!-- =====================================================================
       Include paths (both configurations)
       ===================================================================== -->
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>
        $(ProjectDir);
        $(ProjectDir)Generated Files;
        $(IntDir)Generated Files;
        $(ProjectDir)..\include;
        $(ProjectDir)..\llama.cpp\include;
        $(ProjectDir)..\llama.cpp\src;
        $(ProjectDir)..\llama.cpp\ggml\include;
        $(ProjectDir)..\llama.cpp\ggml\src;
        $(ProjectDir)..\llama.cpp\ggml\src\ggml-cpu;
        %(AdditionalIncludeDirectories)
      </AdditionalIncludeDirectories>
      <PreprocessorDefinitions>
        GGML_USE_CPU=1;
        GGML_BACKEND_DL=0;
        NOMINMAX;
        WIN32_LEAN_AND_MEAN;
        _CRT_SECURE_NO_WARNINGS;
        XLLAMA_UWP=1;
        GGML_VERSION="0.12.0";
        GGML_COMMIT="9a532ae4b";
        %(PreprocessorDefinitions)
      </PreprocessorDefinitions>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <LanguageStandard_C>stdc11</LanguageStandard_C>
      <ConformanceMode>true</ConformanceMode>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <!-- C++/WinRT does NOT use /ZW (C++/CX). Disable it globally so .c files
           can compile. /ZW is for the legacy C++/CX ABI, incompatible with
           pure-C files and with the winrt:: header-only library we use. -->
      <CompileAsWinRT>false</CompileAsWinRT>
      <!-- Preserve directory structure in .obj paths to avoid collision when
           two files share the same basename (e.g. repack.cpp, quants.c, llama.cpp). -->
      <ObjectFileName>$(IntDir)%(RelativeDir)</ObjectFileName>
      <!-- Disable precompiled headers globally. We don't have pch.cpp to create
           the PCH; pch.h is included as a regular header via App.h. -->
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <Link>
      <!-- WindowsApp.lib is the UWP umbrella library -->
      <AdditionalDependencies>WindowsApp.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <!-- Debug-specific compile flags -->
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <BasicRuntimeChecks>EnableFastChecks</BasicRuntimeChecks>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>

  <!-- Release-specific compile flags: AVX2 for Zen 2 (Xbox CPU), LTCG -->
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <InlineFunctionExpansion>AnySuitable</InlineFunctionExpansion>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <FavorSizeOrSpeed>Speed</FavorSizeOrSpeed>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <AdditionalOptions>/arch:AVX2 /Oi /Ot %(AdditionalOptions)</AdditionalOptions>
      <WholeProgramOptimization>true</WholeProgramOptimization>
    </ClCompile>
    <Link>
      <LinkTimeCodeGeneration>UseLinkTimeCodeGeneration</LinkTimeCodeGeneration>
    </Link>
  </ItemDefinitionGroup>

  <!-- =====================================================================
       IDL (MIDL 3 format) — processed by cppwinrt.exe via CppWinRT NuGet.
       Declares App and MainPage runtimeclasses; cppwinrt.exe emits
       xllama.winmd (needed by AppxPackage.Targets for EntryPoint="xllama.App")
       and generates App.g.h / MainPage.g.h used by the C++ source.
       ===================================================================== -->
  <ItemGroup>
    <Midl Include="xllama.idl" />
  </ItemGroup>

  <!-- =====================================================================
       XAML pages
       ===================================================================== -->
  <ItemGroup>
    <ApplicationDefinition Include="App.xaml">
      <SubType>Designer</SubType>
    </ApplicationDefinition>
    <Page Include="MainPage.xaml">
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

  <!-- =====================================================================
       Manifest
       ===================================================================== -->
  <ItemGroup>
    <AppxManifest Include="AppxManifest.xml">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>

  <!-- =====================================================================
       Assets (placeholder PNGs required by AppxManifest)
       ===================================================================== -->
  <ItemGroup>
    <Image Include="Assets\StoreLogo.png" />
    <Image Include="Assets\Square150x150Logo.png" />
    <Image Include="Assets\Square44x44Logo.png" />
    <Image Include="Assets\Wide310x150Logo.png" />
    <Image Include="Assets\SplashScreen.png" />
  </ItemGroup>

  <!-- =====================================================================
       Source files

       IMPORTANT: llama-mmap.cpp and ggml-backend-dl.cpp use Win32 Desktop APIs
       (CreateFileMappingA, LoadLibraryW) blocked in WINAPI_FAMILY_APP.
       They are replaced by UWP-safe stubs in the uwp/ directory.
       ===================================================================== -->

  <!-- ggml base (no GPU backends included) -->
  <ItemGroup>
    <!-- Rename ggml.c → ggml_c.obj: ggml.c and ggml.cpp share the same stem;
         without the override both produce ggml.obj in the same output dir
         and the parallel /MP build silently overwrites one with the other. -->
    <ClCompile Include="..\llama.cpp\ggml\src\ggml.c">
      <ObjectFileName>$(IntDir)%(RelativeDir)ggml_c.obj</ObjectFileName>
    </ClCompile>
    <ClCompile Include="..\llama.cpp\ggml\src\ggml.cpp" />
    <ClCompile Include="..\llama.cpp\ggml\src\ggml-alloc.c" />
    <ClCompile Include="..\llama.cpp\ggml\src\ggml-backend.cpp" />
    <ClCompile Include="..\llama.cpp\ggml\src\ggml-backend-meta.cpp" />
    <ClCompile Include="..\llama.cpp\ggml\src\ggml-opt.cpp" />
    <ClCompile Include="..\llama.cpp\ggml\src\ggml-threading.cpp" />
    <ClCompile Include="..\llama.cpp\ggml\src\ggml-quants.c" />
    <ClCompile Include="..\llama.cpp\ggml\src\gguf.cpp" />
    <!-- Backend registry (uses dl_load_library from our stub, not llama.cpp's) -->
    <ClCompile Include="..\llama.cpp\ggml\src\ggml-backend-reg.cpp" />
    <!-- ggml-backend-dl.cpp EXCLUDED: uses LoadLibraryW (desktop-only).
         Replaced by: ggml-backend-dl-stub.cpp below. -->
  </ItemGroup>

  <!-- ggml CPU backend -->
  <ItemGroup>
    <!-- Same stem conflict as ggml.c/ggml.cpp: rename .c output to avoid overwrite. -->
    <ClCompile Include="..\llama.cpp\ggml\src\ggml-cpu\ggml-cpu.c">
      <ObjectFileName>$(IntDir)%(RelativeDir)ggml-cpu_c.obj</ObjectFileName>
    </ClCompile>
    <ClCompile Include="..\llama.cpp\ggml\src\ggml-cpu\ggml-cpu.cpp" />
    <ClCompile Include="..\llama.cpp\ggml\src\ggml-cpu\repack.cpp" />
    <ClCompile Include="..\llama.cpp\ggml\src\ggml-cpu\hbm.cpp" />
    <ClCompile Include="..\llama.cpp\ggml\src\ggml-cpu\quants.c" />
    <ClCompile Include="..\llama.cpp\ggml\src\ggml-cpu\traits.cpp" />
    <ClCompile Include="..\llama.cpp\ggml\src\ggml-cpu\binary-ops.cpp" />
    <ClCompile Include="..\llama.cpp\ggml\src\ggml-cpu\unary-ops.cpp" />
    <ClCompile Include="..\llama.cpp\ggml\src\ggml-cpu\vec.cpp" />
    <ClCompile Include="..\llama.cpp\ggml\src\ggml-cpu\ops.cpp" />
    <!-- AMX stubs (guarded by __AMX_* intrinsics; compile clean on Zen 2) -->
    <ClCompile Include="..\llama.cpp\ggml\src\ggml-cpu\amx\amx.cpp" />
    <ClCompile Include="..\llama.cpp\ggml\src\ggml-cpu\amx\mmq.cpp" />
    <!-- x86-specific: AVX2 quantisation and repacking for Zen 2 -->
    <ClCompile Include="..\llama.cpp\ggml\src\ggml-cpu\arch\x86\cpu-feats.cpp" />
    <ClCompile Include="..\llama.cpp\ggml\src\ggml-cpu\arch\x86\quants.c" />
    <ClCompile Include="..\llama.cpp\ggml\src\ggml-cpu\arch\x86\repack.cpp" />
  </ItemGroup>

  <!-- llama core (llama-mmap.cpp EXCLUDED — replaced by llama-mmap-uwp.cpp) -->
  <ItemGroup>
    <ClCompile Include="..\llama.cpp\src\llama.cpp" />
    <ClCompile Include="..\llama.cpp\src\llama-adapter.cpp" />
    <ClCompile Include="..\llama.cpp\src\llama-arch.cpp" />
    <ClCompile Include="..\llama.cpp\src\llama-batch.cpp" />
    <ClCompile Include="..\llama.cpp\src\llama-chat.cpp" />
    <ClCompile Include="..\llama.cpp\src\llama-context.cpp" />
    <ClCompile Include="..\llama.cpp\src\llama-cparams.cpp" />
    <ClCompile Include="..\llama.cpp\src\llama-grammar.cpp" />
    <ClCompile Include="..\llama.cpp\src\llama-graph.cpp" />
    <ClCompile Include="..\llama.cpp\src\llama-hparams.cpp" />
    <ClCompile Include="..\llama.cpp\src\llama-impl.cpp" />
    <ClCompile Include="..\llama.cpp\src\llama-io.cpp" />
    <ClCompile Include="..\llama.cpp\src\llama-kv-cache.cpp" />
    <ClCompile Include="..\llama.cpp\src\llama-kv-cache-iswa.cpp" />
    <ClCompile Include="..\llama.cpp\src\llama-memory.cpp" />
    <ClCompile Include="..\llama.cpp\src\llama-memory-hybrid.cpp" />
    <ClCompile Include="..\llama.cpp\src\llama-memory-hybrid-iswa.cpp" />
    <ClCompile Include="..\llama.cpp\src\llama-memory-recurrent.cpp" />
    <!-- llama-mmap.cpp EXCLUDED: uses CreateFileMappingA (desktop-only).
         Replaced by: llama-mmap-uwp.cpp below. -->
    <ClCompile Include="..\llama.cpp\src\llama-model.cpp" />
    <ClCompile Include="..\llama.cpp\src\llama-model-loader.cpp" />
    <ClCompile Include="..\llama.cpp\src\llama-model-saver.cpp" />
    <ClCompile Include="..\llama.cpp\src\llama-quant.cpp" />
    <ClCompile Include="..\llama.cpp\src\llama-sampler.cpp" />
    <ClCompile Include="..\llama.cpp\src\llama-vocab.cpp" />
    <ClCompile Include="..\llama.cpp\src\unicode.cpp" />
    <ClCompile Include="..\llama.cpp\src\unicode-data.cpp" />
    <!-- All model implementations (130+ files, glob is safe: no GPU backends here) -->
    <ClCompile Include="..\llama.cpp\src\models\*.cpp" />
  </ItemGroup>

  <!-- UWP stubs replacing desktop-only llama.cpp internals -->
  <ItemGroup>
    <ClCompile Include="llama-mmap-uwp.cpp" />
    <ClCompile Include="ggml-backend-dl-stub.cpp" />
  </ItemGroup>

  <!-- xllama shared bridge -->
  <ItemGroup>
    <ClCompile Include="..\src\bridge\inference.cpp" />
    <ClCompile Include="..\src\bridge\bench.cpp" />
    <ClCompile Include="..\src\bridge\platform.cpp" />
    <ClCompile Include="..\src\bridge\path_utils.cpp" />
    <ClCompile Include="..\src\bridge\utf8_utils.cpp" />
    <!-- cli.cpp uses POSIX getopt — Linux only, excluded from UWP target -->
    <ClCompile Include="llama-bridge.cpp" />
  </ItemGroup>

  <!-- xllama UWP app -->
  <ItemGroup>
    <ClCompile Include="App.cpp" />
    <ClCompile Include="MainPage.cpp" />
    <!-- module.cpp includes Generated Files\module.g.cpp (cppwinrt 2.0 factory
         aggregator). In cppwinrt 2.x, per-class App.g.cpp / MainPage.g.cpp are
         replaced by a single module.g.cpp; this is the TU that compiles it. -->
    <ClCompile Include="module.cpp" />
    <!-- XamlTypeInfo_impl.cpp provides the definitions of XamlTypeInfoProvider::
         CreateXamlType/CreateXamlMember/OtherProviders that MarkupCompilePass2
         would normally generate but can't because of the WMC9999 crash. -->
    <ClCompile Include="XamlTypeInfo_impl.cpp" />
  </ItemGroup>

  <!-- Suppress upstream llama.cpp warnings only for upstream source files.
       Our uwp/ files compile with full warnings so we catch our own mistakes. -->
  <ItemGroup>
    <ClCompile Update="..\llama.cpp\ggml\src\*">
      <DisableSpecificWarnings>4244;4267;4566;4005;4305;4101;%(DisableSpecificWarnings)</DisableSpecificWarnings>
    </ClCompile>
    <ClCompile Update="..\llama.cpp\ggml\src\ggml-cpu\*">
      <DisableSpecificWarnings>4244;4267;4566;4005;4305;4101;%(DisableSpecificWarnings)</DisableSpecificWarnings>
    </ClCompile>
    <ClCompile Update="..\llama.cpp\ggml\src\ggml-cpu\amx\*">
      <DisableSpecificWarnings>4244;4267;4566;4005;4305;4101;%(DisableSpecificWarnings)</DisableSpecificWarnings>
    </ClCompile>
    <ClCompile Update="..\llama.cpp\ggml\src\ggml-cpu\arch\x86\*">
      <DisableSpecificWarnings>4244;4267;4566;4005;4305;4101;%(DisableSpecificWarnings)</DisableSpecificWarnings>
    </ClCompile>
    <ClCompile Update="..\llama.cpp\src\*">
      <DisableSpecificWarnings>4244;4267;4566;4005;4305;4101;%(DisableSpecificWarnings)</DisableSpecificWarnings>
    </ClCompile>
    <ClCompile Update="..\llama.cpp\src\models\*">
      <DisableSpecificWarnings>4244;4267;4566;4005;4305;4101;%(DisableSpecificWarnings)</DisableSpecificWarnings>
    </ClCompile>
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

  <!-- NuGet package targets (restored to packages\ relative to this vcxproj) -->
  <Import Project="packages\Microsoft.Windows.CppWinRT.2.0.240405.15\build\native\Microsoft.Windows.CppWinRT.targets"
          Condition="Exists('packages\Microsoft.Windows.CppWinRT.2.0.240405.15\build\native\Microsoft.Windows.CppWinRT.targets')" />

  <!-- MarkupCompilePass2 (XBF compiler / C++ codegen) crashes with WMC9999 for
       C++/WinRT UWP projects in both SDK 22621 and 26100. Removing event handler
       attributes from XAML does not fix the crash. Override with an empty target
       to skip Pass2. InitializeComponent, Connect, GetBindingConnector, and
       XamlTypeInfoProvider private methods are provided manually in
       MainPage.cpp and XamlTypeInfo_impl.cpp instead. -->
  <Target Name="MarkupCompilePass2"/>

  <!-- CopyGeneratedXaml: Pass2 is disabled (WMC9999). Override creates empty XBF
       stubs (AppXPackage.Targets expects them) and stages the source XAML files
       so LoadComponent(ms-appx:///MainPage.xaml) works at runtime on Xbox.

       Key: $(OutDir) = x64\Release\xllama\ (already includes TargetName).
       Stock targets use $(OutDir)$(TargetName)\ which double-nests — that path
       is one level below where the AppX packager reads its inputs. All output
       here goes directly to $(OutDir) which is the correct staging root. -->
  <Target Name="CopyGeneratedXaml"
          AfterTargets="MarkupCompilePass2"
          BeforeTargets="_GenerateProjectPriConfigurationFiles">
    <MakeDir Directories="$(OutDir)"/>
    <!-- XBF stubs: build-uwp.ps1 pre-creates them; Touch here is a safety net. -->
    <Touch Files="$(OutDir)App.xbf;$(OutDir)MainPage.xbf" AlwaysCreate="true"/>
    <!-- Copy source XAML to the same staging root as the XBF stubs. -->
    <Copy SourceFiles="App.xaml;MainPage.xaml"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"/>
    <!-- Extend CustomOutputGroupForPackagingOutput so the AppX packager adds
         the text XAML to the package layout (stock property only lists XBF). -->
    <PropertyGroup>
      <CustomOutputGroupForPackagingOutput>$(CustomOutputGroupForPackagingOutput);$(OutDir)App.xaml;$(OutDir)MainPage.xaml</CustomOutputGroupForPackagingOutput>
    </PropertyGroup>
  </Target>

</Project>
