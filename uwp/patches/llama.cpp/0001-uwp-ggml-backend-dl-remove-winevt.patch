diff --git a/ggml/src/ggml-backend-dl.h b/ggml/src/ggml-backend-dl.h
index f74b7c948..d7c421091 100644
--- a/ggml/src/ggml-backend-dl.h
+++ b/ggml/src/ggml-backend-dl.h
@@ -6,7 +6,8 @@
 #       define NOMINMAX
 #   endif
 #   include <windows.h>
-#   include <winevt.h>
+// <winevt.h> removed: pulled in by upstream oversight, not needed here,
+// and its Event Log declarations are WINAPI_PARTITION_DESKTOP-only.
 #else
 #    include <dlfcn.h>
 #    include <unistd.h>
@@ -21,7 +22,12 @@ using dl_handle = std::remove_pointer_t<HMODULE>;
 
 struct dl_handle_deleter {
     void operator()(HMODULE handle) {
+#if WINAPI_FAMILY_PARTITION(WINAPI_PARTITION_APP) && !WINAPI_FAMILY_PARTITION(WINAPI_PARTITION_DESKTOP)
+        // In UWP the dl stubs always return nullptr, so handle is never valid.
+        (void)handle;
+#else
         FreeLibrary(handle);
+#endif
     }
 };
 
