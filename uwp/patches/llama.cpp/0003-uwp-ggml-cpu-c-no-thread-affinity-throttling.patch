diff --git a/ggml/src/ggml-cpu/ggml-cpu.c b/ggml/src/ggml-cpu/ggml-cpu.c
index cd5c61a81..02cc8f8fb 100644
--- a/ggml/src/ggml-cpu/ggml-cpu.c
+++ b/ggml/src/ggml-cpu/ggml-cpu.c
@@ -2489,7 +2489,14 @@ static bool ggml_thread_apply_affinity(bool * mask) {
 
     DWORD_PTR m = (DWORD_PTR)bitmask;
 
+#if WINAPI_FAMILY_PARTITION(WINAPI_PARTITION_DESKTOP)
+    // SetThreadAffinityMask is WINAPI_PARTITION_DESKTOP-only.
+    // In UWP (Xbox) the sandbox controls affinity; silently succeed.
     m = SetThreadAffinityMask(h, m);
+#else
+    (void)m; (void)h;
+    m = 1; // report success
+#endif
 
     return m != 0;
 }
@@ -2511,7 +2518,8 @@ static bool ggml_thread_apply_priority(int32_t prio) {
         // Newer Windows 11 versions aggressively park (offline) CPU cores and often place
         // all our threads onto the first 4 cores which results in terrible performance with
         // n_threads > 4
-        #if _WIN32_WINNT >= 0x0602
+        // SetThreadInformation is WINAPI_PARTITION_DESKTOP-only; skip in UWP.
+        #if _WIN32_WINNT >= 0x0602 && WINAPI_FAMILY_PARTITION(WINAPI_PARTITION_DESKTOP)
         THREAD_POWER_THROTTLING_STATE t;
         ZeroMemory(&t, sizeof(t));
         t.Version     = THREAD_POWER_THROTTLING_CURRENT_VERSION;
